{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/view-formatting.schema.json",
  "hideColumnHeader": true,
  "groupProps": {
    "headerFormatter": {
      "elmType": "div",
      "style": {
        "display": "flex",
        "align-items": "flex-end",
        "width": "100%",
        "padding": "6px 0"
      },
      "children": [
        {
          "elmType": "div",
          "style": {
            "width": "330px",
            "flex": "none",
            "font-size": "13px",
            "font-weight": "600",
            "white-space": "nowrap",
            "overflow": "hidden",
            "text-overflow": "ellipsis"
          },
          "children": [
            {
              "elmType": "span",
              "txtContent": "@group.fieldData",
              "style": {
                "font-family": "ui-monospace, monospace",
                "font-size": "11.5px",
                "color": "#616161"
              }
            },
            {
              "elmType": "span",
              "txtContent": "=' （' + toString(@group.count) + ' 件）'",
              "style": {
                "font-weight": "400",
                "color": "#616161",
                "font-size": "11.5px"
              }
            }
          ]
        },
        {
          "elmType": "div",
          "style": {
            "flex": "1",
            "position": "relative",
            "height": "18px",
            "border-left": "1px solid #e1dfdd"
          },
          "children": [
            {
              "elmType": "div",
              "style": {
                "position": "absolute",
                "top": "0",
                "bottom": "0",
                "width": "1px",
                "background-color": "#f0eeed",
                "left": "20%"
              }
            },
            {
              "elmType": "div",
              "style": {
                "position": "absolute",
                "top": "0",
                "bottom": "0",
                "width": "1px",
                "background-color": "#f0eeed",
                "left": "40%"
              }
            },
            {
              "elmType": "div",
              "style": {
                "position": "absolute",
                "top": "0",
                "bottom": "0",
                "width": "1px",
                "background-color": "#f0eeed",
                "left": "80%"
              }
            },
            {
              "elmType": "div",
              "style": {
                "position": "absolute",
                "top": "0",
                "bottom": "0",
                "width": "2px",
                "background-color": "#c50f1f",
                "left": "60.0%"
              }
            },
            {
              "elmType": "span",
              "txtContent": "90日前",
              "style": {
                "position": "absolute",
                "left": "3px",
                "top": "2px",
                "font-size": "10.5px",
                "color": "#616161"
              }
            },
            {
              "elmType": "span",
              "txtContent": "今日",
              "style": {
                "position": "absolute",
                "left": "62%",
                "top": "2px",
                "font-size": "10.5px",
                "color": "#c50f1f"
              }
            },
            {
              "elmType": "span",
              "txtContent": "60日後",
              "style": {
                "position": "absolute",
                "right": "3px",
                "top": "2px",
                "font-size": "10.5px",
                "color": "#616161"
              }
            }
          ]
        }
      ]
    }
  },
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "align-items": "center",
      "width": "100%",
      "border-top": "1px solid #f0eeed"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "width": "330px",
          "flex": "none",
          "display": "flex",
          "align-items": "center",
          "padding": "6px 10px 6px 24px",
          "box-sizing": "border-box",
          "overflow": "hidden"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "width": "9px",
              "height": "9px",
              "border-radius": "2px",
              "flex": "none",
              "margin-right": "7px",
              "background-color": "=if([$Kind] == 'トラブル', '#c50f1f', if([$Kind] == '改修', '#0f6cbd', if([$Kind] == '構成変更', '#7160e8', '#c07000')))"
            }
          },
          {
            "elmType": "div",
            "inlineEditField": "[$Status]",
            "txtContent": "[$Status]",
            "style": {
              "font-size": "10.5px",
              "border": "1px solid #e1dfdd",
              "border-radius": "3px",
              "padding": "0 5px",
              "color": "#616161",
              "flex": "none",
              "margin-right": "7px",
              "background-color": "#ffffff",
              "cursor": "pointer"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "attributes": {
              "title": "[$Title]"
            },
            "style": {
              "font-size": "12.5px",
              "white-space": "nowrap",
              "overflow": "hidden",
              "text-overflow": "ellipsis",
              "flex": "1"
            }
          },
          {
            "elmType": "button",
            "txtContent": "···",
            "customRowAction": {
              "action": "openContextMenu"
            },
            "style": {
              "border": "none",
              "background-color": "transparent",
              "color": "#616161",
              "cursor": "pointer",
              "flex": "none",
              "font-size": "14px",
              "padding": "0 4px"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "flex": "1",
          "position": "relative",
          "height": "34px",
          "border-left": "1px solid #e1dfdd"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "position": "absolute",
              "top": "0",
              "bottom": "0",
              "width": "1px",
              "background-color": "#f0eeed",
              "left": "20%"
            }
          },
          {
            "elmType": "div",
            "style": {
              "position": "absolute",
              "top": "0",
              "bottom": "0",
              "width": "1px",
              "background-color": "#f0eeed",
              "left": "40%"
            }
          },
          {
            "elmType": "div",
            "style": {
              "position": "absolute",
              "top": "0",
              "bottom": "0",
              "width": "1px",
              "background-color": "#f0eeed",
              "left": "80%"
            }
          },
          {
            "elmType": "div",
            "style": {
              "position": "absolute",
              "top": "0",
              "bottom": "0",
              "width": "2px",
              "background-color": "#c50f1f",
              "opacity": "0.35",
              "left": "60.0%"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$Kind]",
            "customRowAction": {
              "action": "defaultClick"
            },
            "customCardProps": {
              "openOnEvent": "hover",
              "directionalHint": "bottomLeftEdge",
              "formatter": {
                "elmType": "div",
                "style": {
                  "padding": "10px 12px",
                  "width": "280px",
                  "font-size": "12px",
                  "line-height": "1.7"
                },
                "children": [
                  {
                    "elmType": "div",
                    "txtContent": "[$Title]",
                    "style": {
                      "font-weight": "600",
                      "margin-bottom": "5px"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "=toLocaleDateString([$OccurredOn]) + ' 〜 ' + if([$ClosedOn] == '', '（未定）', toLocaleDateString([$ClosedOn])) + ' ／ 担当 ' + [$Assignee.title]",
                    "style": {
                      "color": "#616161",
                      "font-size": "11.5px",
                      "margin-bottom": "6px"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "'内容'",
                    "style": {
                      "font-weight": "600"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "[$Detail]",
                    "style": {
                      "white-space": "pre-wrap"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "'対応したこと'",
                    "style": {
                      "font-weight": "600",
                      "margin-top": "6px"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "[$Action]",
                    "style": {
                      "white-space": "pre-wrap"
                    }
                  }
                ]
              }
            },
            "style": {
              "position": "absolute",
              "top": "9px",
              "height": "16px",
              "border-radius": "8px",
              "display": "flex",
              "align-items": "center",
              "padding": "0 7px",
              "box-sizing": "border-box",
              "font-size": "10.5px",
              "color": "#ffffff",
              "white-space": "nowrap",
              "overflow": "hidden",
              "cursor": "pointer",
              "background-color": "=if([$Kind] == 'トラブル', '#c50f1f', if([$Kind] == '改修', '#0f6cbd', if([$Kind] == '構成変更', '#7160e8', '#c07000')))",
              "opacity": "=if([$Status] == '解決', '0.45', '1')",
              "left": "=toString(((if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 < -90, -90, if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 > 60, 60, (Number(Date([$OccurredOn])) - Number(@now)) / 86400000))) + 90) / 150 * 100) + '%'",
              "width": "=toString(if(((if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) < -90, -90, if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) > 60, 60, if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000)))) + 90) / 150 * 100 - ((if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 < -90, -90, if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 > 60, 60, (Number(Date([$OccurredOn])) - Number(@now)) / 86400000))) + 90) / 150 * 100 < 2, 2, ((if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) < -90, -90, if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) > 60, 60, if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000)))) + 90) / 150 * 100 - ((if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 < -90, -90, if((Number(Date([$OccurredOn])) - Number(@now)) / 86400000 > 60, 60, (Number(Date([$OccurredOn])) - Number(@now)) / 86400000))) + 90) / 150 * 100)) + '%'"
            }
          },
          {
            "elmType": "div",
            "txtContent": "=if([$Status] != '解決' && [$ClosedOn] != '' && Number(Date([$ClosedOn])) < Number(@now), '▲ 期日を過ぎています', if([$Status] == '解決', '✓', ''))",
            "style": {
              "position": "absolute",
              "top": "11px",
              "font-size": "11px",
              "white-space": "nowrap",
              "left": "=toString(((if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) < -90, -90, if(if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000) > 60, 60, if([$ClosedOn] == '', 0, (Number(Date([$ClosedOn])) - Number(@now)) / 86400000)))) + 90) / 150 * 100 + 1) + '%'",
              "color": "=if([$Status] == '解決', '#616161', '#c50f1f')"
            }
          }
        ]
      }
    ]
  }
}
