{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 300,
  "width": 300,
  "hideSelection": false,
  "formatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "height": "100%",
      "border": "1px solid #e1dfdd",
      "border-radius": "6px",
      "overflow": "hidden",
      "background-color": "#ffffff",
      "box-sizing": "border-box"
    },
    "children": [
      {
        "elmType": "img",
        "attributes": {
          "src": "=getThumbnailImage([$ConfigImage], 300, 88)",
          "title": "構成図"
        },
        "style": {
          "width": "100%",
          "height": "88px",
          "object-fit": "cover",
          "display": "=if([$ConfigImage] == '', 'none', '')"
        }
      },
      {
        "elmType": "div",
        "style": {
          "padding": "10px 12px",
          "flex": "1"
        },
        "children": [
          {
            "elmType": "div",
            "txtContent": "[$Title]",
            "style": {
              "font-size": "11px",
              "color": "#616161",
              "font-family": "ui-monospace, monospace"
            }
          },
          {
            "elmType": "div",
            "txtContent": "[$EnvName]",
            "style": {
              "font-size": "13px",
              "font-weight": "600",
              "margin": "2px 0 8px",
              "line-height": "1.5",
              "-webkit-line-clamp": "2",
              "overflow": "hidden"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "flex-wrap": "wrap",
              "margin-bottom": "8px"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "[$Stage]",
                "style": {
                  "padding": "1px 8px",
                  "border-radius": "10px",
                  "font-size": "11px",
                  "margin-right": "5px",
                  "background-color": "=if([$Stage] == '本番', '#fde7e9', if([$Stage] == 'SIT', '#fff4ce', '#e8f1fb'))"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$Status]",
                "style": {
                  "padding": "1px 8px",
                  "border-radius": "10px",
                  "font-size": "11px",
                  "margin-right": "5px",
                  "background-color": "=if([$Status] == '稼働中', '#dff6dd', if([$Status] == '構築中', '#fff4ce', '#f3f2f1'))"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$OrgUse]",
                "style": {
                  "padding": "1px 8px",
                  "border-radius": "10px",
                  "font-size": "11px",
                  "background-color": "#f3f2f1"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "font-size": "12px",
              "line-height": "1.7",
              "color": "#242424"
            },
            "children": [
              {
                "elmType": "div",
                "txtContent": "='ホスト名  ' + [$HostName]",
                "style": {
                  "font-family": "ui-monospace, monospace",
                  "font-size": "11.5px",
                  "white-space": "nowrap",
                  "overflow": "hidden",
                  "text-overflow": "ellipsis"
                }
              },
              {
                "elmType": "div",
                "txtContent": "='所在  ' + [$Location]",
                "style": {
                  "white-space": "nowrap",
                  "overflow": "hidden",
                  "text-overflow": "ellipsis"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "txtContent": "='最終更新から ' + toString(floor((Number(@now) - Number([$Modified])) / 86400000)) + ' 日'",
            "style": {
              "display": "inline-block",
              "margin-top": "9px",
              "padding": "3px 8px",
              "border-radius": "3px",
              "font-size": "11.5px",
              "background-color": "=if(floor((Number(@now) - Number([$Modified])) / 86400000) > 90, '#fde7e9', if(floor((Number(@now) - Number([$Modified])) / 86400000) > 30, '#fff4ce', '#dff6dd'))",
              "color": "=if(floor((Number(@now) - Number([$Modified])) / 86400000) > 90, '#a01020', if(floor((Number(@now) - Number([$Modified])) / 86400000) > 30, '#7a5a00', '#0b5c0b'))"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "gap": "6px",
          "padding": "0 12px 12px"
        },
        "children": [
          {
            "elmType": "button",
            "txtContent": "詳細",
            "customRowAction": {
              "action": "defaultClick"
            },
            "style": {
              "flex": "1",
              "border": "1px solid #e1dfdd",
              "background-color": "#ffffff",
              "border-radius": "4px",
              "padding": "5px 0",
              "font-size": "12.5px",
              "cursor": "pointer"
            }
          },
          {
            "elmType": "button",
            "txtContent": "編集",
            "customRowAction": {
              "action": "editProps"
            },
            "style": {
              "flex": "1",
              "border": "1px solid #e1dfdd",
              "background-color": "#ffffff",
              "border-radius": "4px",
              "padding": "5px 0",
              "font-size": "12.5px",
              "cursor": "pointer"
            }
          }
        ]
      }
    ]
  }
}
